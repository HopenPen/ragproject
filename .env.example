# Назначение файла: имена настроек; секреты заполняет оператор или tools.manage bootstrap.
APP_IMAGE=science-extract:local
MINIO_IMAGE=science-extract-minio:2025-10-15
ENVIRONMENT=development
APP_MODE=backend
POSTGRES_DB=science
POSTGRES_USER=science
POSTGRES_PASSWORD=
DATABASE_URL=
RABBITMQ_DEFAULT_USER=science
RABBITMQ_DEFAULT_PASS=
RABBITMQ_DEFAULT_VHOST=science
RABBITMQ_URL=
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_BUCKET=science-extract
S3_ACCESS_KEY=
S3_SECRET_KEY=
JWT_ISSUER=science-extract
JWT_AUDIENCE=science-extract-api
JWT_KEY_PATH=/keys/private.pem
JWT_PUBLIC_PATH=/public-keys/jwks.json
GATEWAY_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
OPENAI_API_KEY=
MODEL_ID=gpt-6.1-terra
MAX_PDF_BYTES=104857600
MAX_PDF_PAGES=300
MODEL_TIMEOUT=180
MAX_RETRIES=3
MODEL_MAX_CALLS=250
ALLOWED_ORIGINS=[]
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost
INGRESS_HOST=0.0.0.0
INGRESS_PORT=80
INPUTS_PATH=./inputs
EXTERNAL_CHECKER_PATH=/inputs/solar/tools/check_submission.py
RUNTIME_PATH=/runtime
